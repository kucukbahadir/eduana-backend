// schema.prisma

// Datasource & generator
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  COORDINATOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Models
model User {
  id                  String                   @id @default(uuid())
  full_name           String
  age                 Int
  language_preference String?
  diet_restrictions   String?
  experience          String?
  remarks             String?
  role                Role
  location_id         String?
  location            Location?                @relation(fields: [location_id], references: [id])
  enrollments         Enrollment[]
  teachings           Teaching[]
  attendances         Attendance[]
  sessionEvaluations  SessionEvaluation[]
  finalEvaluations    FinalEvaluation[]        @relation("FinalEvaluatedUser")
  evaluationsGiven    FinalEvaluation[]        @relation("EvaluatorRelation")
  gamificationPoints  GamificationPoints[]
  userBadges          UserBadge[]
  parentAccounts      ParentAccount[]          @relation("ParentLink")
  children            ParentAccount[]          @relation("StudentLink")
  externalAccounts    ExternalStudentAccount[]
  announcements       Announcement[]           @relation("AnnouncementAuthor")

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Curriculum {
  id               String   @id @default(uuid())
  title            String
  program_type     String
  difficulty_level String
  classes          Class[]
  lessons          Lesson[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Class {
  id            String         @id @default(uuid())
  curriculum_id String?
  curriculum    Curriculum?    @relation(fields: [curriculum_id], references: [id])
  location_id   String?
  location      Location?      @relation(fields: [location_id], references: [id])
  enrollments   Enrollment[]
  sessions      Session[]
  announcements Announcement[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Lesson {
  id                 String               @id @default(uuid())
  curriculum_id      String
  curriculum         Curriculum           @relation(fields: [curriculum_id], references: [id])
  title              String
  description        String
  keywords           LessonKeyword[]
  sessions           Session[]
  presentationSlides PresentationSlides[]
  kahoots            Kahoot[]
  sessionEvaluations SessionEvaluation[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Session {
  id                 String              @id @default(uuid())
  class_id           String
  class              Class               @relation(fields: [class_id], references: [id])
  lesson_id          String
  lesson             Lesson              @relation(fields: [lesson_id], references: [id])
  location_id        String?
  location           Location?           @relation(fields: [location_id], references: [id])
  date               DateTime
  start_time         DateTime
  end_time           DateTime
  teachings          Teaching[]
  attendances        Attendance[]
  sessionEvaluations SessionEvaluation[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Teaching {
  id         String  @id @default(uuid())
  session_id String
  session    Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Enrollment {
  id       String @id @default(uuid())
  user_id  String
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Attendance {
  id         String           @id @default(uuid())
  session_id String
  user_id    String
  status     AttendanceStatus
  note       String?
  timestamp  DateTime
  session    Session          @relation(fields: [session_id], references: [id])
  user       User             @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model SessionEvaluation {
  id         String  @id @default(uuid())
  session_id String
  lesson_id  String
  user_id    String
  feedback   String
  score      Int
  session    Session @relation(fields: [session_id], references: [id])
  lesson     Lesson  @relation(fields: [lesson_id], references: [id])
  user       User    @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model FinalEvaluation {
  id           String           @id @default(uuid())
  user_id      String
  evaluator_id String?
  metrics      Json
  proficiency  ProficiencyLevel
  user         User             @relation("FinalEvaluatedUser", fields: [user_id], references: [id])
  evaluator    User?            @relation("EvaluatorRelation", fields: [evaluator_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model PresentationSlides {
  id        String @id @default(uuid())
  lesson_id String
  lesson    Lesson @relation(fields: [lesson_id], references: [id])
  url       String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Kahoot {
  id        String @id @default(uuid())
  lesson_id String
  lesson    Lesson @relation(fields: [lesson_id], references: [id])
  url       String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Keyword {
  id      String          @id @default(uuid())
  value   String          @unique
  lessons LessonKeyword[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model LessonKeyword {
  lesson_id  String
  keyword_id String
  lesson     Lesson  @relation(fields: [lesson_id], references: [id])
  keyword    Keyword @relation(fields: [keyword_id], references: [id])

  @@id([lesson_id, keyword_id])
}

model ParentAccount {
  id         String @id @default(uuid())
  parent_id  String
  student_id String
  parent     User   @relation("ParentLink", fields: [parent_id], references: [id])
  student    User   @relation("StudentLink", fields: [student_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model ExternalStudentAccount {
  id            String @id @default(uuid())
  student_id    String
  platform_name String
  credentials   String
  student       User   @relation(fields: [student_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model GamificationPoints {
  id          String  @id @default(uuid())
  user_id     String
  category    String
  points      Int
  description String?
  awarded_by  String?
  user        User    @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  icon        String
  description String
  userBadges  UserBadge[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model UserBadge {
  id       String @id @default(uuid())
  user_id  String
  badge_id String
  user     User   @relation(fields: [user_id], references: [id])
  badge    Badge  @relation(fields: [badge_id], references: [id])

  created_at DateTime  @default(now())
  deleted_at DateTime?
}

model Location {
  id            String         @id @default(uuid())
  name          String
  address       String
  users         User[]
  classes       Class[]
  sessions      Session[]
  announcements Announcement[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Announcement {
  id          String    @id @default(uuid())
  message     String
  class_id    String?
  class       Class?    @relation(fields: [class_id], references: [id])
  location_id String?
  location    Location? @relation(fields: [location_id], references: [id])
  author_id   String?
  author      User?     @relation("AnnouncementAuthor", fields: [author_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}
