// schema.prisma

// Datasource & generator
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  COORDINATOR
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Models

// Existing User model
model User {
  id                  String                   @id @default(uuid())
  full_name           String
  age                 Int
  language_preference String?
  diet_restrictions   String?
  experience          String?
  remarks             String?
  role                Role
  location_id         String?
  location            Location?                @relation(fields: [location_id], references: [id])
  parent_phone_number String? // Added for emergency contact
  enrollments         Enrollment[]
  teachings           Teaching[]
  attendances         Attendance[]
  sessionEvaluations  SessionEvaluation[]
  finalEvaluations    FinalEvaluation[]        @relation("FinalEvaluatedUser")
  evaluationsGiven    FinalEvaluation[]        @relation("EvaluatorRelation")
  gamificationPoints  GamificationPoints[]
  userBadges          UserBadge[]
  parentAccounts      ParentAccount[]          @relation("ParentLink")
  children            ParentAccount[]          @relation("StudentLink")
  externalAccounts    ExternalStudentAccount[]
  announcements       Announcement[]           @relation("AnnouncementAuthor")

  // New relations for tracking student progress
  studentKeywordProgresses    StudentKeywordProgress[]
  studentGameLearningGoalLogs StudentGameLearningGoalLog[]
  gameSessions                GameSession[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing Curriculum model - Modified for 'Level' Model and retaining program_type, difficulty_level
model Curriculum {
  id               String   @id @default(uuid())
  title            String
  program_type     String // Retained as additional metadata
  difficulty_level Int    // Retained as additional metadata
  classes          Class[]
  lessons          Lesson[]
  levels           Level[] // New: Relationship to the new Level model

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}
model Class {
  id            String         @id @default(uuid())
  name          String
  curriculum_id String?
  curriculum    Curriculum?    @relation(fields: [curriculum_id], references: [id])
  location_id   String?
  location      Location?      @relation(fields: [location_id], references: [id])
  enrollments   Enrollment[]
  sessions      Session[]
  announcements Announcement[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}
model Lesson {
  id                  String               @id @default(uuid())
  curriculum_id       String
  curriculum          Curriculum           @relation(fields: [curriculum_id], references: [id])
  title               String
  description         String
  keywords            LessonKeyword[]
  learning_objectives LessonObjective[]
  sessions            Session[]
  resources           Resources[]
  questions           Question[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Session {
  id                 String              @id @default(uuid())
  class_id           String
  class              Class               @relation(fields: [class_id], references: [id])
  lesson_id          String
  lesson             Lesson              @relation(fields: [lesson_id], references: [id])
  location_id        String?
  location           Location?           @relation(fields: [location_id], references: [id])
  date               DateTime
  start_time         DateTime
  end_time           DateTime
  teachings          Teaching[]
  attendances        Attendance[]
  sessionEvaluations SessionEvaluation[]
  gameSessions       GameSession[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing Teaching model
model Teaching {
  id         String  @id @default(uuid())
  session_id String
  session    Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing Enrollment model
model Enrollment {
  id       String @id @default(uuid())
  user_id  String
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Attendance {
  id         String           @id @default(uuid())
  session_id String
  user_id    String
  present    Boolean?
  late       Boolean?
  excused    Boolean?
  note       String?
  timestamp  DateTime
  session    Session          @relation(fields: [session_id], references: [id])
  user       User             @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([session_id, user_id])
}

model SessionEvaluation {
  session_id String 
  user_id    String

  participation_score   Int   // 1 - 5 scale
  understanding_score   Int   // 1 - 5 scale
  collaboration_score   Int   // 1 - 5 scale
  problem_solving_score Int   // 1 - 5 scale
  task_completion_score Int   // 1 - 5 scale

  session    Session @relation(fields: [session_id], references: [id])
  user       User    @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@id([session_id, user_id])
}

// Existing FinalEvaluation model
model FinalEvaluation {
  id           String           @id @default(uuid())
  user_id      String
  evaluator_id String?
  metrics      Json
  proficiency  ProficiencyLevel
  user         User             @relation("FinalEvaluatedUser", fields: [user_id], references: [id])
  evaluator    User?            @relation("EvaluatorRelation", fields: [evaluator_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

enum ResourceType {
  SLIDES
  KAHOOT
}

model Resources {
  id          String       @id @default(uuid())
  url         String
  type        ResourceType
  language    String
  
  lesson_id   String
  lesson      Lesson       @relation(fields: [lesson_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Keyword {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?

  lessons                   LessonKeyword[]
  questions                 Question[]
  studentKeywordProgresses  StudentKeywordProgress[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing LessonKeyword model (intermediary for Lesson to Keyword, aligned with PART 2)
model LessonKeyword {
  lesson_id  String
  keyword_id String
  lesson     Lesson  @relation(fields: [lesson_id], references: [id])
  keyword    Keyword @relation(fields: [keyword_id], references: [id])

  @@id([lesson_id, keyword_id])
}

model LessonObjective {
  id            String @id @default(uuid())
  lesson_id     String
  lesson        Lesson @relation(fields: [lesson_id], references: [id])
  objective     String
  descriptions  Json

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

// Existing ParentAccount model
model ParentAccount {
  id         String @id @default(uuid())
  parent_id  String
  student_id String
  parent     User   @relation("ParentLink", fields: [parent_id], references: [id])
  student    User   @relation("StudentLink", fields: [student_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing ExternalStudentAccount model
model ExternalStudentAccount {
  id            String @id @default(uuid())
  student_id    String
  platform_name String
  credentials   String
  student       User   @relation(fields: [student_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing GamificationPoints model
model GamificationPoints {
  id          String  @id @default(uuid())
  user_id     String
  category    String
  points      Int
  description String?
  awarded_by  String?
  user        User    @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing Badge model
model Badge {
  id          String      @id @default(uuid())
  name        String
  icon        String
  description String
  userBadges  UserBadge[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing UserBadge model
model UserBadge {
  id       String @id @default(uuid())
  user_id  String
  badge_id String
  user     User   @relation(fields: [user_id], references: [id])
  badge    Badge  @relation(fields: [badge_id], references: [id])

  created_at DateTime  @default(now())
  deleted_at DateTime?
}

// Existing Location model
model Location {
  id            String         @id @default(uuid())
  name          String
  address       String
  users         User[]
  classes       Class[]
  sessions      Session[]
  announcements Announcement[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// Existing Announcement model
model Announcement {
  id          String    @id @default(uuid())
  message     String
  class_id    String?
  class       Class?    @relation(fields: [class_id], references: [id])
  location_id String?
  location    Location? @relation(fields: [location_id], references: [id])
  author_id   String?
  author      User?     @relation("AnnouncementAuthor", fields: [author_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

// --- NEW MODELS FROM PART 2 ---

// New Level model
// Represents a specific level within a curriculum (e.g., "Beginner Circuits" for Electronics Level 1)
model Level {
  id            String     @id @default(uuid())
  curriculum_id String
  curriculum    Curriculum @relation(fields: [curriculum_id], references: [id])
  level_number  Int // e.g., 1, 2, 3 (order within curriculum)
  title         String?
  description   String?

  questions Question[] // New: Questions can be tied to a specific level (difficulty)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// New Question model
model Question {
  id                         String  @id @default(uuid())
  lesson_id                  String
  lesson                     Lesson  @relation(fields: [lesson_id], references: [id])
  keyword_id                 String
  keyword                    Keyword @relation(fields: [keyword_id], references: [id])
  level_id                   String // FK to Level model, indicating question difficulty/curriculum level
  level                      Level   @relation(fields: [level_id], references: [id])
  question_text              String
  answers                    Json // JSON array of 3 answer choices
  correct_answer_index       Int // Integer: 0–2, index of the correct option
  explanation_correct_answer String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// New Game model
model Game {
  id                      String                       @id @default(uuid())
  name                    String                       @unique
  type                    String // e.g., "theory", "practice"
  description             String?
  learningGoals           GameLearningGoal[]
  studentLearningGoalLogs StudentGameLearningGoalLog[]
  gameSessions            GameSession[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// New GameLearningGoal model
model GameLearningGoal {
  id                      String                       @id @default(uuid())
  game_id                 String
  game                    Game                         @relation(fields: [game_id], references: [id])
  goal_description        String
  studentLearningGoalLogs StudentGameLearningGoalLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// New StudentProgressTracking model
model StudentKeywordProgress {
  id                String  @id @default(uuid())
  student_id        String
  student           User    @relation(fields: [student_id], references: [id])
  keyword_id        String
  keyword           Keyword @relation(fields: [keyword_id], references: [id]) // Corrected: This is the field causing the error
  learning_progress Int     @default(0) @map("level") // Renamed for clarity, maps to 'level' in DB
  // Note: 'level' in here is student's mastery level, not a curriculum level

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// New StudentGameLearningGoalLog model
model StudentGameLearningGoalLog {
  id           String           @id @default(uuid())
  student_id   String
  student      User             @relation(fields: [student_id], references: [id])
  game_id      String
  game         Game             @relation(fields: [game_id], references: [id])
  goal_id      String
  learningGoal GameLearningGoal @relation(fields: [goal_id], references: [id])
  achieved_at  DateTime

  created_at DateTime @default(now()) // Can use achieved_at, but created_at for logging
  updated_at DateTime @updatedAt
}

// New GameSession model
model GameSession {
  id              String    @id @default(uuid())
  student_id      String
  student         User      @relation(fields: [student_id], references: [id])
  game_id         String
  game            Game      @relation(fields: [game_id], references: [id])
  session_id      String? // Optional: Link to a physical class session if played during one
  session         Session?  @relation(fields: [session_id], references: [id])
  started_at      DateTime
  ended_at        DateTime?
  durationSeconds Int? // Optional: For analytics if needed

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
