# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduana_db
DB_USER=db_username
DB_PASSWORD=your_strong_password_here

# Connection string - automatically constructed from database configuration variables
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Frontend URL for CORS and redirects
DEV_URL="http://localhost:3000"

# Security
JWT_SECRET_KEY="replace_with_secure_random_string_at_least_32_chars"